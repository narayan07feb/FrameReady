<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SampleApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="FR Standard Sample"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <profileable android:shell="true" />

        <activity
            android:name="com.example.samplestandard.SplashActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name="com.example.samplestandard.StandardMainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        </activity>

        <!-- FrameReady: 8 initializers across different SDK categories -->
        <provider
            android:name="com.frameready.FrameReadyProvider"
            android:authorities="${applicationId}.frameready"
            android:exported="false">
            <!-- No-dependency initializers (run in parallel immediately) -->
            <meta-data android:name="com.example.samplestandard.AnalyticsInitializer"     android:value="post_frame_initializer" />
            <meta-data android:name="com.example.samplestandard.CrashReporterInitializer" android:value="post_frame_initializer" />
            <meta-data android:name="com.example.samplestandard.ImageLoaderInitializer"   android:value="post_frame_initializer" />
            <meta-data android:name="com.example.samplestandard.DatabaseInitializer"      android:value="post_frame_initializer" />
            <meta-data android:name="com.example.samplestandard.ConfigInitializer"        android:value="post_frame_initializer" />
            <!-- Dependent initializers (FrameReady Kahn-sorts these automatically) -->
            <meta-data android:name="com.example.samplestandard.FeatureFlagsInitializer"      android:value="post_frame_initializer" />
            <meta-data android:name="com.example.samplestandard.PushNotificationInitializer"  android:value="post_frame_initializer" />
            <meta-data android:name="com.example.samplestandard.NetworkCacheInitializer"      android:value="post_frame_initializer" />
            <!-- Failure-isolation initializers: FailingInitializer throws; its dependent cascades -->
            <meta-data android:name="com.example.samplestandard.FailingInitializer"           android:value="post_frame_initializer" />
            <meta-data android:name="com.example.samplestandard.DependentOnFailingInitializer" android:value="post_frame_initializer" />
        </provider>


    </application>

</manifest>
